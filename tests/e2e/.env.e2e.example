# Copy to tests/e2e/.env.e2e and fill in. Never commit the real file.
E2E_BASE_URL=http://localhost:5173

# Test inbox (Ethereal in dev). The api sends verification mail here; the
# e2e specs read the 6-digit code back over IMAP.
E2E_IMAP_HOST=imap.ethereal.email
E2E_IMAP_PORT=993
E2E_IMAP_USER=
E2E_IMAP_PASS=
