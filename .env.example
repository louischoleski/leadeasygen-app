# Copy to .env.local for local dev; set the same keys as Environment
# Variables in the Vercel project for a deployment.

# Where the API lives. Defaults to http://localhost:3000 when unset, which is
# ONLY correct for local dev — a deployed frontend must point at the public
# API origin, and that origin must list this site in its CORS allow-list.
VITE_API_URL=http://localhost:3000

# Optional: without a key, the location input on "New scrape job" works as a
# plain text field (no autocomplete). Requires "Places API (New)" enabled on
# the key's Google Cloud project.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: enables in-app card entry (Stripe Elements). Without it the app
# falls back to hosted Stripe checkout. Publishable key only — never the secret.
VITE_STRIPE_PUBLISHABLE_KEY=
